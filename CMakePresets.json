{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 28, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja Multi-Config",
      "binaryDir": "${sourceDir}/.build/${presetName}",
      "cacheVariables": {
        "CIPH_DIST_DIR": "${sourceDir}/dist"
      }
    },
    {
      "name": "dev",
      "displayName": "Dev (default compiler)",
      "description": "Uses whichever C++ compiler CMake finds in the environment (CXX, PATH, MSVC dev shell).",
      "inherits": "base"
    },
    {
      "name": "dev-clang",
      "displayName": "Dev (Clang)",
      "inherits": "base",
      "cacheVariables": { "CMAKE_CXX_COMPILER": "clang++" }
    },
    {
      "name": "dev-gcc",
      "displayName": "Dev (GCC)",
      "inherits": "base",
      "cacheVariables": { "CMAKE_CXX_COMPILER": "g++" }
    },
    {
      "name": "dev-msvc",
      "displayName": "Dev (MSVC)",
      "description": "Run from a Developer PowerShell / VS command prompt, or open the folder in Visual Studio.",
      "inherits": "base",
      "cacheVariables": { "CMAKE_CXX_COMPILER": "cl" },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    },
    {
      "name": "ci",
      "displayName": "CI",
      "description": "Default compiler, Release. Flip CIPH_WARNINGS_AS_ERRORS on once the code is warning-clean. ciph-studio is skipped: it needs windowing system packages the runners do not have.",
      "inherits": "base",
      "cacheVariables": { "CIPH_WARNINGS_AS_ERRORS": "OFF", "CIPH_BUILD_STUDIO": "OFF" }
    }
  ],
  "buildPresets": [
    { "name": "dev",           "configurePreset": "dev",       "configuration": "Debug" },
    { "name": "dev-release",   "configurePreset": "dev",       "configuration": "Release" },
    { "name": "dev-clang",     "configurePreset": "dev-clang", "configuration": "Debug" },
    { "name": "dev-gcc",       "configurePreset": "dev-gcc",   "configuration": "Debug" },
    { "name": "dev-msvc",      "configurePreset": "dev-msvc",  "configuration": "Debug" },
    { "name": "ci",            "configurePreset": "ci",        "configuration": "Release" }
  ],
  "testPresets": [
    {
      "name": "base",
      "hidden": true,
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error" }
    },
    { "name": "dev",       "inherits": "base", "configurePreset": "dev",       "configuration": "Debug" },
    { "name": "dev-clang", "inherits": "base", "configurePreset": "dev-clang", "configuration": "Debug" },
    { "name": "dev-gcc",   "inherits": "base", "configurePreset": "dev-gcc",   "configuration": "Debug" },
    { "name": "dev-msvc",  "inherits": "base", "configurePreset": "dev-msvc",  "configuration": "Debug" },
    { "name": "ci",        "inherits": "base", "configurePreset": "ci",        "configuration": "Release" }
  ],
  "workflowPresets": [
    {
      "name": "dev",
      "steps": [
        { "type": "configure", "name": "dev" },
        { "type": "build", "name": "dev" },
        { "type": "test", "name": "dev" }
      ]
    },
    {
      "name": "ci",
      "steps": [
        { "type": "configure", "name": "ci" },
        { "type": "build", "name": "ci" },
        { "type": "test", "name": "ci" }
      ]
    }
  ]
}
